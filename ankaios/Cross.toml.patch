diff --git a/Cross.toml b/Cross.toml
new file mode 100644
index 0000000..9539bf9
--- /dev/null
+++ b/Cross.toml
@@ -0,0 +1,7 @@
+[target.aarch64-unknown-linux-musl]
+pre-build = [
+    "apt-get update && apt-get install -y --no-install-recommends curl ca-certificates unzip",
+    "curl -L -o /tmp/protoc.zip https://github.com/protocolbuffers/protobuf/releases/download/v25.3/protoc-25.3-linux-x86_64.zip",
+    "unzip -o /tmp/protoc.zip -d /usr/local && chmod +x /usr/local/bin/protoc",
+    "protoc --version",
+]
